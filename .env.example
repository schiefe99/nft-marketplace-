# Ativa a camada de mocks (MSW) — também no build de demonstração. Padrão: true
VITE_ENABLE_MOCKS=true
# Cenário inicial dos mocks (pode ser sobrescrito por ?scenario= na URL ou pelo painel "Mocks")
VITE_MOCK_SCENARIO=default
# Base da API REST (interceptada pelo MSW). Padrão: /api
VITE_API_URL=/api
# Timeout do Axios em ms. Padrão: 10000
VITE_API_TIMEOUT_MS=10000
# Origem do servidor Socket.IO (interceptado pelo MSW). Padrão: a própria origem da página
# VITE_SOCKET_URL=
